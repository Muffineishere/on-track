{
  "expo": {
    "name": "On Track",
    "slug": "on-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ontrack",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F2EB",
    "ios": {
      "bundleIdentifier": "com.ontrack.tunas",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ontrack.tunas",
      "adaptiveIcon": {
        "backgroundColor": "#1F5A45",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "On Track",
      "shortName": "On Track",
      "themeColor": "#1F5A45",
      "backgroundColor": "#F5F2EB"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#1F5A45"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F2EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0E1311"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
